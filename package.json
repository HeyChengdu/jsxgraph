{
  "name": "jsxgraph",
  "description": "Interactive geometry, plotting, visualization",
  "homepage": "https://jsxgraph.org",
  "version": "1.13.1",
  "exports": {
    "types": "./src/index.d.ts",
    "default": "./src/index.js"
  },
  "main": "./distrib/jsxgraphcore.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "distrib",
    "extensions",
    "CHANGELOG.md"
  ],
  "maintainers": [
    {
      "name": "Alfred Wassermann",
      "email": "Alfred.Wassermann@uni-bayreuth.de"
    },
    {
      "name": "Michael Gerhaeuser",
      "email": "michael.gerhaeuser@gmail.com"
    }
  ],
  "contributors": [
    "Matthias Ehmann <matthias.ehmann@uni-bayreuth.de>",
    "Carsten Miller <carsten.miller@uni-bayreuth.de>",
    "Rinat Shigapov",
    "Bianca Valentin",
    "Heiko Vogel",
    "Andreas Walter",
    "Peter Wilfahrt"
  ],
  "license": "(MIT OR LGPL-3.0-or-later)",
  "keywords": [
    "geometry",
    "dynamic geometry",
    "function plotting",
    "mathematics education"
  ],
  "bugs": {
    "url": "https://github.com/jsxgraph/jsxgraph/issues"
  },
  "directories": {
    "lib": "src"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jsxgraph/jsxgraph.git"
  },
  "prettier": {
    "printWidth": 96,
    "tabWidth": 4,
    "trailingComma": "none"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.4.0",
    "@types/jasmine": "^5.1.8",
    "eslint": ">=10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5",
    "globals": "^15.4.0",
    "http-server": "^14.1.1",
    "jasmine-core": "^3.10.1",
    "jsdoc2": "^2.4.0",
    "jshint": "^0.5.9",
    "jslint": "^0.12.1",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "npmignore": "^0.3.1",
    "path-browserify": "^1.0.1",
    "prettier": "^3.8.1",
    "terser-webpack-plugin": ">=5.6.1",
    "typescript": "^5.9.3",
    "webpack": ">=5.105.4",
    "webpack-cli": ">=7.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "buildCore": "webpack --config config/webpack.config.js",
    "buildCompressor": "webpack --config config/webpack.config.compressor.js",
    "eslint": "make eslint",
    "check-format": "prettier --check src test extensions",
    "//No! format": "//prettier --write src test extensions",
    "serve": "http-server -c-1",
    "test": "make test",
    "test:coverage": "npm run buildCore && npm run test:contracts:compile && karma start karma/karma.coverage.conf.js",
    "test:contracts": "npm run test:contracts:compile && karma start karma/karma.contracts.conf.js",
    "test:contracts:compile": "tsc -p test/contracts/tsconfig.json",
    "test:types": "tsc -p test/types/tsconfig.json && tsc -p test/contracts/tsconfig.json --noEmit"
  },
  "dependencies": {}
}
